    ],
    "category": "jiuye",
    "related_majors": [
      "计算机科学与技术",
      "软件工程"
    ],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-jiuye-006",
    "text": "学技术的永远不会失业，因为社会永远需要能干活的人。",
    "context": "强调技术类专业的就业保障",
    "tags": [
      "技术",
      "就业",
      "实用",
      "保障"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-jiuye-007",
    "text": "第一份工作非常重要，它决定了你在哪个圈子、接触什么人、未来往哪个方向走。",
    "context": "强调第一份工作对职业发展的奠基作用",
    "tags": [
      "第一份工作",
      "职业发展",
      "圈子",
      "方向"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-jiuye-008",
    "text": "别光看平均薪资，你要看中位数。平均薪资是被马云拉上去的，跟你没关系。",
    "context": "揭示专业薪资数据的统计陷阱",
    "tags": [
      "薪资",
      "中位数",
      "统计陷阱",
      "现实"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "humorous"
  },
  {
    "id": "zxf-jiuye-009",
    "text": "国企的好处不是工资高，是工资稳。你旱涝保收，过年有年终奖，退休有保障。",
    "context": "分析国企就业的核心优势",
    "tags": [
      "国企",
      "稳定",
      "福利",
      "退休"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-jiuye-010",
    "text": "私企给你画饼，国企给你发饼。你自己选。",
    "context": "对比私企和国企的薪酬兑现",
    "tags": [
      "私企",
      "国企",
      "画饼",
      "选择"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "humorous"
  },
  {
    "id": "zxf-jiuye-011",
    "text": "自媒体不是职业，是副业。你见过几个自媒体做了十年还活得好的？",
    "context": "警告年轻人不要把自媒体当主业",
    "tags": [
      "自媒体",
      "自由职业",
      "稳定性",
      "风险"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-jiuye-012",
    "text": "考研不是逃避就业的借口。你要想清楚，三年后就业环境会不会比现在更好？",
    "context": "批评盲目考研的延迟就业行为",
    "tags": [
      "考研",
      "延迟就业",
      "规划",
      "就业"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-jiuye-013",
    "text": "毕业去大城市还是回小城市？有能力去大城市，没关系回小城市。就这么简单。",
    "context": "分析大城市和小城市的就业选择",
    "tags": [
      "大城市",
      "小城市",
      "就业选择",
      "能力",
      "关系"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-jiuye-014",
    "text": "行业有周期，你得在上升期进去，别在下降期接盘。房地产、教培就是前车之鉴。",
    "context": "分析行业周期对就业的影响",
    "tags": [
      "行业周期",
      "房地产",
      "教培",
      "择业"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-jiuye-015",
    "text": "女生就业确实比男生难，这是现实。所以女生更要选对专业，别让专业再给你加一道坎。",
    "context": "直面性别就业差距的现实",
    "tags": [
      "性别",
      "就业差距",
      "女生",
      "专业选择"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-jiuye-016",
    "text": "起薪高不代表天花板高。有些行业起薪8000封顶一万，有些起薪5000但能到五万。看长远。",
    "context": "分析起薪和职业天花板的关系",
    "tags": [
      "起薪",
      "天花板",
      "职业发展",
      "长远"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-jiuye-017",
    "text": "海归也不值钱了。你花两百万出去留学，回来跟国内985抢同一个岗位，人家还嫌你不了解国内市场。",
    "context": "分析海归学历贬值的现象",
    "tags": [
      "海归",
      "留学",
      "学历贬值",
      "就业"
    ],
    "category": "jiuye",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-jiuye-018",
    "text": "好的大专比烂的本科强。你学个护理、学个数控，出来就能上手干活，企业抢着要。",
    "context": "为职业教育正名",
    "tags": [
      "大专",
      "职业教育",
      "技术",
      "就业",
      "本科"
    ],
    "category": "jiuye",
    "related_majors": [
      "护理学",
      "机械设计制造"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-rensheng-001",
    "text": "高考是普通人改变命运成本最低的方式，没有之一。",
    "context": "强调高考对于普通家庭的重要意义",
    "tags": [
      "高考",
      "命运",
      "普通人",
      "机会"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-rensheng-002",
    "text": "你看到的那些说学历不重要的人，他们自己全是名校毕业。",
    "context": "讽刺「读书无用论」，揭示幸存者偏差",
    "tags": [
      "学历",
      "名校",
      "幸存者偏差",
      "读书无用论"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-rensheng-003",
    "text": "社会的本质就是分层的。教育是你往上走的电梯，错过了就只能爬楼梯。",
    "context": "谈论教育与社会阶层流动的关系",
    "tags": [
      "社会分层",
      "教育",
      "阶层流动",
      "机会"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-rensheng-004",
    "text": "别跟我谈理想，先把饭吃饱再说。",
    "context": "强调务实择业，先解决生存问题",
    "tags": [
      "理想",
      "现实",
      "务实",
      "生存"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-rensheng-005",
    "text": "孩子不懂事不可怕，可怕的是家长也不懂事。",
    "context": "批评部分家长在志愿填报中的盲目性",
    "tags": [
      "家长",
      "认知",
      "志愿填报",
      "信息差"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-rensheng-006",
    "text": "你的人生不是只有一次高考，但高考确实是最公平的那一次。",
    "context": "强调高考制度的相对公平性",
    "tags": [
      "高考",
      "公平",
      "机会",
      "人生"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-rensheng-007",
    "text": "阶层固化不是说说而已。你爸不是李刚，你就得比别人多努力十倍。",
    "context": "谈论阶层固化对普通人的影响",
    "tags": [
      "阶层固化",
      "家境",
      "努力",
      "普通人"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-rensheng-008",
    "text": "穷人和富人最大的差距不是钱，是信息差。人家知道的事你根本不知道。",
    "context": "分析信息差对人生选择的影响",
    "tags": [
      "信息差",
      "穷富差距",
      "认知",
      "选择"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-rensheng-009",
    "text": "你以为是你的努力让你成功了？不，是平台。换个平台，你什么都不是。",
    "context": "强调平台和环境比个人努力更重要",
    "tags": [
      "平台",
      "努力",
      "环境",
      "成功"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-rensheng-010",
    "text": "婚姻就是第二次投胎。你嫁错了人或者娶错了人，后半辈子比选错专业还惨。",
    "context": "将婚姻选择与人生选择类比",
    "tags": [
      "婚姻",
      "选择",
      "人生",
      "经济"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-rensheng-011",
    "text": "普通人输不起。你试错的成本，可能是你全家三年的积蓄。",
    "context": "提醒普通家庭做选择要谨慎",
    "tags": [
      "普通人",
      "试错成本",
      "家庭",
      "谨慎"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-rensheng-012",
    "text": "龙生龙、凤生凤，这话虽然难听，但你看看周围就知道了。教育是打破代际传递唯一的机会。",
    "context": "谈论代际传递和教育的破局作用",
    "tags": [
      "代际传递",
      "教育",
      "阶层",
      "破局"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-rensheng-013",
    "text": "人脉不是你认识谁，是你对谁有用。没有利用价值，谁也不会搭理你。",
    "context": "谈论人脉的本质",
    "tags": [
      "人脉",
      "价值",
      "社会",
      "现实"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-rensheng-014",
    "text": "认清自己很重要。你不是天才，大部分人都不是。接受平凡，然后在平凡中找到最优解。",
    "context": "鼓励考生认清自身定位",
    "tags": [
      "认清自己",
      "平凡",
      "定位",
      "最优解"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-rensheng-015",
    "text": "先苦后甜和先甜后苦，你选哪个？年轻的时候吃苦不叫苦，老了吃苦才叫苦。",
    "context": "鼓励年轻人趁年轻奋斗",
    "tags": [
      "先苦后甜",
      "年轻",
      "奋斗",
      "人生"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-rensheng-016",
    "text": "北京的孩子考400分上的学校，河南的孩子要考600分。你跟我说公平？",
    "context": "揭示高考地区不平等现象",
    "tags": [
      "地区不平等",
      "北京",
      "河南",
      "高考公平"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-rensheng-017",
    "text": "18岁选错了路，你可能要用一辈子来纠正。这就是为什么高考志愿那么重要。",
    "context": "强调高考志愿选择的深远影响",
    "tags": [
      "18岁",
      "选择",
      "人生",
      "志愿填报"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-rensheng-018",
    "text": "这个社会不会因为你善良就对你好。你得有本事，善良才有意义。",
    "context": "强调能力比品德更现实",
    "tags": [
      "善良",
      "能力",
      "社会",
      "现实"
    ],
    "category": "rensheng",
    "related_majors": [],
    "sentiment": "critical"
  },
  {
    "id": "zxf-xuexi-001",
    "text": "高三拼的不是智商，是体力和意志力。能坚持到最后的人就赢了。",
    "context": "鼓励高三考生坚持备考",
    "tags": [
      "高三",
      "意志力",
      "坚持",
      "备考"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-xuexi-002",
    "text": "不要用战术上的勤奋掩盖战略上的懒惰。方向比努力重要。",
    "context": "强调学习方法和方向选择的重要性",
    "tags": [
      "学习方法",
      "战略",
      "方向",
      "效率"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-xuexi-003",
    "text": "别感动自己。你坐在书桌前12个小时，真正有效学习可能只有4个小时。提高效率比拼时长重要。",
    "context": "批评低效学习方式",
    "tags": [
      "效率",
      "学习时间",
      "感动自己",
      "有效学习"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-xuexi-004",
    "text": "数学是拉开差距的科目。数学好的人，选专业范围比别人大一倍。",
    "context": "强调数学成绩的重要性",
    "tags": [
      "数学",
      "差距",
      "专业选择",
      "基础"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-xuexi-005",
    "text": "与其花时间把优势科目从140提到145，不如把劣势科目从80提到100。补短板比拔高更划算。",
    "context": "分析高考提分策略",
    "tags": [
      "补短板",
      "提分",
      "策略",
      "效率"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-xuexi-006",
    "text": "考试的时候心态占一半。平时700分的水平，心态崩了只能考600。练心态跟练题一样重要。",
    "context": "强调考试心态的重要性",
    "tags": [
      "心态",
      "考试",
      "发挥",
      "备考"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-xuexi-007",
    "text": "模拟考考砸了是好事。高考前把问题暴露出来，总比高考的时候暴露强。",
    "context": "安慰模拟考失利的考生",
    "tags": [
      "模拟考",
      "心态",
      "暴露问题",
      "积极"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-xuexi-008",
    "text": "时间管理就是命运管理。你每天浪费两小时刷手机，一年就是730小时，够你多考50分了。",
    "context": "警示时间浪费的代价",
    "tags": [
      "时间管理",
      "手机",
      "自律",
      "提分"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-xuexi-009",
    "text": "错题本是最好的复习资料，没有之一。你做过的错题就是你的知识漏洞，反复看它比刷新题有用十倍。",
    "context": "推荐错题本复习法",
    "tags": [
      "错题本",
      "复习",
      "知识漏洞",
      "学习方法"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-xuexi-010",
    "text": "高三别熬夜。你以为你在拼命，其实你在透支。第二天上课犯困，得不偿失。",
    "context": "提醒考生注意身体健康和作息",
    "tags": [
      "熬夜",
      "健康",
      "作息",
      "效率"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-xuexi-011",
    "text": "最后一个月别学新知识了，把会的东西巩固到滚瓜烂熟。高考考的是你会的，不是你不会的。",
    "context": "高考最后冲刺阶段建议",
    "tags": [
      "最后冲刺",
      "巩固",
      "复习策略",
      "高考"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-xuexi-012",
    "text": "到了大学，没人管你了。自律的人上天堂，放纵的人下地狱。大学四年荒废了，比没上大学还惨。",
    "context": "警示大学生自律的重要性",
    "tags": [
      "大学",
      "自律",
      "荒废",
      "学习"
    ],
    "category": "xuexi",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-yuanxiao-001",
    "text": "能上985就别去211，能上211就别去双非。学校层次就是你的第一张名片。",
    "context": "强调学校层次对就业的决定性影响",
    "tags": [
      "985",
      "211",
      "学校层次",
      "名片"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-yuanxiao-002",
    "text": "兰州大学，985中的隐藏王者，性价比极高，分数低但实力强。",
    "context": "推荐被低估的985院校",
    "tags": [
      "兰州大学",
      "985",
      "性价比",
      "被低估"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-003",
    "text": "哈工大威海，985的牌子、二线的分数，工科生的宝藏学校。",
    "context": "推荐性价比高的985分校区",
    "tags": [
      "哈工大威海",
      "985",
      "性价比",
      "工科"
    ],
    "category": "yuanxiao",
    "related_majors": [
      "机械工程",
      "计算机科学与技术"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-004",
    "text": "东北大学，虽然地理位置吃亏，但自动化、计算机在全国都是顶级的。",
    "context": "推荐东北大学的优势学科",
    "tags": [
      "东北大学",
      "985",
      "自动化",
      "计算机",
      "地理位置"
    ],
    "category": "yuanxiao",
    "related_majors": [
      "自动化",
      "计算机科学与技术"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-005",
    "text": "西北农林科技大学，985中分数最低的，但进去就是985的学历，考研、考公都好使。",
    "context": "推荐分数线最低的985学校",
    "tags": [
      "西北农林",
      "985",
      "低分",
      "性价比",
      "考研"
    ],
    "category": "yuanxiao",
    "related_majors": [
      "农学",
      "食品科学与工程"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-006",
    "text": "中国海洋大学，985里面最容易被忽略的，海洋科学全国第一。",
    "context": "推荐被忽略的985院校",
    "tags": [
      "中国海洋大学",
      "985",
      "海洋科学",
      "被忽略"
    ],
    "category": "yuanxiao",
    "related_majors": [
      "海洋科学",
      "水产"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-007",
    "text": "上海大学，211里面的王者。在上海就是最大的优势，实习、就业机会碾压外省985。",
    "context": "推荐地理位置优越的211院校",
    "tags": [
      "上海大学",
      "211",
      "上海",
      "就业",
      "城市优势"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-008",
    "text": "南京理工、南京航空，军工背景的211，就业率高得吓人。",
    "context": "推荐军工背景的211院校",
    "tags": [
      "南京理工",
      "南京航空",
      "211",
      "军工",
      "就业率"
    ],
    "category": "yuanxiao",
    "related_majors": [
      "兵器工程",
      "航空航天工程"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-009",
    "text": "合肥工业大学，低调到没人知道，但工科就业杠杠的。中建、中铁每年招一大批。",
    "context": "推荐低调但就业好的211",
    "tags": [
      "合肥工大",
      "211",
      "工科",
      "就业",
      "低调"
    ],
    "category": "yuanxiao",
    "related_majors": [
      "土木工程",
      "机械工程"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-010",
    "text": "苏州大学，211里面进步最快的，地处苏州，产业发达，不愁就业。",
    "context": "推荐发展快速的211院校",
    "tags": [
      "苏州大学",
      "211",
      "苏州",
      "产业",
      "就业"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-yuanxiao-011",
    "text": "宁去大城市的211，不去小城市的985。城市决定了你的眼界、实习和第一份工作。",
    "context": "城市优先于学校层次的观点",
    "tags": [
      "城市",
      "211",
      "985",
      "眼界",
      "实习"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-yuanxiao-012",
    "text": "双一流不等于老985/211。有些新入选的双一流，社会认可度还没跟上来。",
    "context": "区分双一流和传统985/211的认可度",
    "tags": [
      "双一流",
      "985",
      "211",
      "社会认可"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-yuanxiao-013",
    "text": "选学校也要看它的王牌专业。去了好学校但读了个烂专业，不如去差一档的学校读王牌专业。",
    "context": "强调学校与专业的组合匹配",
    "tags": [
      "王牌专业",
      "学校选择",
      "组合",
      "匹配"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-yuanxiao-014",
    "text": "能去省会就别去地级市。省会的资源、机会、人脉，地级市给不了你。",
    "context": "强调省会城市的资源优势",
    "tags": [
      "省会",
      "地级市",
      "资源",
      "机会"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-yuanxiao-015",
    "text": "独立学院和民办大学，能不去就不去。学费贵、社会认可低，出来找工作被歧视。",
    "context": "警告考生慎选独立学院和民办高校",
    "tags": [
      "独立学院",
      "民办",
      "学费",
      "歧视",
      "就业"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-yuanxiao-016",
    "text": "好的高职比烂三本强。深圳职业技术大学、金华职业技术学院，就业率比很多本科都高。",
    "context": "为优质高职院校正名",
    "tags": [
      "高职",
      "三本",
      "就业率",
      "深职",
      "性价比"
    ],
    "category": "yuanxiao",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-zhiyuan-celue-001",
    "text": "冲一冲、稳一稳、保一保。前两个志愿冲梦想，中间稳住，最后两个保底。",
    "context": "平行志愿填报的经典策略",
    "tags": [
      "冲稳保",
      "平行志愿",
      "策略",
      "填报技巧"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-zhiyuan-celue-002",
    "text": "服从调剂一定要勾！不勾服从调剂，你就是在拿自己的前途赌博。",
    "context": "强调服从调剂的重要性，避免滑档",
    "tags": [
      "服从调剂",
      "滑档",
      "风险",
      "填报"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhiyuan-celue-003",
    "text": "填志愿的优先级：城市 > 学校 > 专业。城市决定平台，学校决定起点，专业决定方向。",
    "context": "志愿填报的优先级排序",
    "tags": [
      "城市",
      "学校",
      "专业",
      "优先级",
      "填报"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-zhiyuan-celue-004",
    "text": "不要浪费你的每一分。多一分能上更好的学校，少一分可能掉一个档次。",
    "context": "强调分数利用效率",
    "tags": [
      "分数",
      "效率",
      "填报",
      "性价比"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhiyuan-celue-005",
    "text": "平行志愿不是乱填的。要按分数从高到低排列，第一个冲、最后一个保底，中间阶梯式下降。",
    "context": "解释平行志愿的正确排序逻辑",
    "tags": [
      "平行志愿",
      "排序",
      "阶梯",
      "技巧"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-zhiyuan-celue-006",
    "text": "提前批一定要关注！很多人不知道，提前批不影响后面的正常批次，等于白捡一次机会。",
    "context": "提醒考生利用提前批机会",
    "tags": [
      "提前批",
      "机会",
      "策略",
      "填报"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-zhiyuan-celue-007",
    "text": "分数够985但只能去冷门专业，你去不去？去！先进去再说，大不了转专业。",
    "context": "建议先进好学校再想办法转专业",
    "tags": [
      "985",
      "冷门专业",
      "转专业",
      "策略"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-zhiyuan-celue-008",
    "text": "你在哪个城市上大学，大概率会在那个城市工作。地理锁定效应比你想象的强得多。",
    "context": "强调大学所在城市对未来工作地点的锁定",
    "tags": [
      "城市",
      "地理锁定",
      "就业",
      "选择"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhiyuan-celue-009",
    "text": "填志愿是全家的事，不是孩子一个人的事。但最终决定权要给孩子，因为路是他自己走的。",
    "context": "平衡家长参与和考生自主权",
    "tags": [
      "全家",
      "决定权",
      "沟通",
      "填报"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-zhiyuan-celue-010",
    "text": "看三年的录取数据，不要只看一年的。一年的数据是偶然，三年的数据才是规律。",
    "context": "建议参考多年录取数据",
    "tags": [
      "录取数据",
      "三年",
      "规律",
      "参考"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-zhiyuan-celue-011",
    "text": "花几千块找专家咨询值不值？如果能帮你避免选错专业浪费四年，那是最划算的投资。",
    "context": "为专业志愿咨询服务正名",
    "tags": [
      "咨询",
      "投资",
      "专家",
      "值不值"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-zhiyuan-celue-012",
    "text": "志愿填报不是高考出分后才开始的。高二就应该开始了解专业、了解学校、了解政策。",
    "context": "强调提前准备志愿填报的重要性",
    "tags": [
      "提前准备",
      "高二",
      "规划",
      "时间窗"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhiyuan-celue-013",
    "text": "分数在一本线上下的考生最纠结。我的建议是：宁可去好的二本王牌专业，也不要去差的一本混日子。",
    "context": "给一本线边缘考生的建议",
    "tags": [
      "一本线",
      "二本",
      "王牌专业",
      "选择"
    ],
    "category": "zhiyuan-celue",
    "related_majors": [],
    "sentiment": "neutral"
  },
  {
    "id": "zxf-zhuanye-001",
    "text": "如果你家境一般，没有任何社会资源，不要学金融。",
    "context": "谈论金融专业就业门槛，强调金融行业对家庭背景和人脉资源的依赖",
    "tags": [
      "金融",
      "家境",
      "专业选择",
      "社会资源"
    ],
    "category": "zhuanye",
    "related_majors": [
      "金融学",
      "经济学",
      "投资学"
    ],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhuanye-002",
    "text": "计算机专业是普通家庭孩子改变命运性价比最高的专业。",
    "context": "推荐普通家庭考生选择技术类专业",
    "tags": [
      "计算机",
      "普通家庭",
      "改变命运",
      "性价比"
    ],
    "category": "zhuanye",
    "related_majors": [
      "计算机科学与技术",
      "软件工程",
      "人工智能"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-zhuanye-003",
    "text": "生化环材，四大天坑，能不碰就别碰。",
    "context": "警告考生慎选就业前景不佳的理科专业",
    "tags": [
      "生化环材",
      "天坑专业",
      "就业",
      "避坑"
    ],
    "category": "zhuanye",
    "related_majors": [
      "生物科学",
      "化学",
      "环境工程",
      "材料科学"
    ],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhuanye-004",
    "text": "医学专业，穷人家孩子的好选择，但你要能吃苦。学制长、考试多，但一旦熬出来，越老越值钱。",
    "context": "分析医学专业的利弊，强调延迟回报",
    "tags": [
      "医学",
      "吃苦",
      "长期回报",
      "穷人家孩子"
    ],
    "category": "zhuanye",
    "related_majors": [
      "临床医学",
      "口腔医学",
      "中医学"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-zhuanye-005",
    "text": "新闻学，如果你家里没有矿，就别报了。",
    "context": "批评新闻学专业就业难、薪资低",
    "tags": [
      "新闻学",
      "就业",
      "薪资",
      "家境"
    ],
    "category": "zhuanye",
    "related_majors": [
      "新闻学",
      "传播学",
      "广播电视学"
    ],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhuanye-006",
    "text": "电气工程，闷声发大财的专业。国家电网、南方电网，你进去了就知道有多香。",
    "context": "推荐电气工程专业，强调国企就业优势",
    "tags": [
      "电气工程",
      "国家电网",
      "国企",
      "高薪"
    ],
    "category": "zhuanye",
    "related_majors": [
      "电气工程及其自动化",
      "电力系统"
    ],
    "sentiment": "encouraging"
  },
  {
    "id": "zxf-zhuanye-007",
    "text": "法学，除了五院四系，其他学校的法学，就业很难。",
    "context": "强调法学专业的学校层次对就业的决定性影响",
    "tags": [
      "法学",
      "五院四系",
      "学校层次",
      "就业"
    ],
    "category": "zhuanye",
    "related_majors": [
      "法学"
    ],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhuanye-008",
    "text": "土木工程，以前是香饽饽，现在是大坑。房地产黄金时代过去了。",
    "context": "分析土木工程专业随行业变化的就业前景",
    "tags": [
      "土木工程",
      "房地产",
      "行业变化",
      "就业"
    ],
    "category": "zhuanye",
    "related_majors": [
      "土木工程",
      "建筑学"
    ],
    "sentiment": "cautionary"
  },
  {
    "id": "zxf-zhuanye-009",
    "text": "师范专业，铁饭碗中的铁饭碗。女生首选，稳定、体面、有寒暑假。",
    "context": "推荐师范专业的稳定性和生活质量优势",
    "tags": [
